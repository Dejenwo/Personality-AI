{
  "name": "personality-dna-ai",
  "private": true,
  "version": "0.1.0",
  "description": "PersonalityDNA AI — AI-powered personality intelligence and human development platform",
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "pnpm --filter @personalitydna/web dev",
